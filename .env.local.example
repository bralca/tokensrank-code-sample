# Private local dashboard; no hosted credentials are needed.
NEXT_PUBLIC_API_BASE=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_MODE=local
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=3001

# Public sharing is optional and needs a separately configured hosted service.
# TOKENSRANK_HOSTED_API_BASE=http://localhost:3201
# TOKENSRANK_HOSTED_SITE_URL=http://localhost:3200

# Set this when sharing a fork or a separate code-sample repository.
# NEXT_PUBLIC_SOURCE_URL=https://github.com/your-account/your-repository
