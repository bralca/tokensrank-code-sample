{
  "name": "tokensrank-monorepo",
  "version": "0.0.1",
  "description": "TokensRank: Verify and rank AI tool usage",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm exec dotenv -e .env.local -- pnpm -r --parallel dev",
    "dev:local": "pnpm exec dotenv -e .env.local -- pnpm -r --parallel --filter @tokensrank/local-api --filter @tokensrank/web dev:local",
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --passWithNoTests",
    "test:db:reset": "tsx scripts/reset-test-schemas.ts",
    "test:integration": "pnpm --filter @tokensrank/web test:integration",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "db:migrate": "node scripts/db-migrate.mjs",
    "prepare": "husky",
    "privacy:check": "tsx scripts/check-script-privacy.ts packages/script/bin/agent.mjs",
    "privacy:test": "pnpm --filter @tokensrank/script exec bats test/forbidden-keys.bats",
    "privacy:check-all": "pnpm privacy:check && pnpm privacy:test",
    "type-check": "pnpm -r type-check",
    "typecheck": "pnpm -r type-check",
    "test:publish:local": "node scripts/test-publish-local.mjs",
    "dev:both": "node scripts/dev-both.mjs",
    "db:check": "node scripts/check-publishing-setup.mjs",
    "db:reset:operational": "node scripts/reset-operational-data.mjs",
    "pricing:sync": "node --import ./scripts/load-env.mjs --import tsx apps/api/src/scripts/sync-pricing.ts",
    "test:local:browser": "playwright test --config playwright.local.config.ts",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^20.19.39",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autocannon": "^8.0.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "^16.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.17"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<8.5.28": "8.5.28",
      "ws@<8.21.0": "8.21.3",
      "@babel/core@>=7 <7.29.6": "7.29.6",
      "find-my-way@>=9 <9.7.0": "9.9.0",
      "nanoid@>=3 <3.3.18": "3.3.19",
      "browserslist@<4.28.7": "4.28.9",
      "fflate@>=0.7 <0.7.5": "0.7.5",
      "baseline-browser-mapping@<2.11.0": "2.11.23",
      "sharp@<0.35.5": "0.35.5",
      "fast-uri@>=3 <3.1.8": "3.1.8",
      "fast-uri@>=4 <4.1.5": "4.1.5",
      "source-map-js@<1.2.2": "1.2.2",
      "fast-copy@>=4 <4.1.0": "4.1.0"
    }
  },
  "packageManager": "pnpm@10.27.0"
}
