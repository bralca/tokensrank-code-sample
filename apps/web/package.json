{
  "name": "@tokensrank/web",
  "version": "0.0.1",
  "description": "TokensRank Next.js frontend",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:local": "next dev --port 3000",
    "build": "next build",
    "build:css": "tailwindcss -i ./styles/globals.css -c ./tailwind.config.js -o ./.next/tailwind-build.css --minify",
    "audit:bundle": "tsx scripts/check-no-service-role-leak.ts .next",
    "start": "next start",
    "lint": "eslint --ext .ts,.tsx app components lib",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts --passWithNoTests --exclude app/lib/api.integration.test.ts",
    "test:integration": "vitest run --config vitest.config.ts app/components/**/*.integration.test.{ts,tsx} app/lib/api.integration.test.ts",
    "test:e2e": "playwright test --workers=1",
    "type-check": "tsc --noEmit",
    "typecheck": "pnpm run type-check"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/calendar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/scatterplot": "^0.99.0",
    "@supabase/supabase-js": "^2.41.0",
    "@tokensrank/shared": "workspace:*",
    "@vercel/og": "^0.11.1",
    "next": "^15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.74.0",
    "lucide-react": "^0.468.0",
    "recharts": "^3.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.59.1",
    "@types/eslint": "^8.56.12",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "eslint-plugin-tokensrank": "workspace:*",
    "jsdom": "^29.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
