{
  "name": "@tokensrank/api",
  "version": "0.0.1",
  "description": "TokensRank Fastify backend API",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--require dotenv/config' tsx --watch src/server.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@supabase/supabase-js": "^2.41.0",
    "@tokensrank/shared": "workspace:*",
    "@vercel/og": "^0.11.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "lru-cache": "^10.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.5",
    "ulid": "^3.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "esbuild": "0.27.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
