# TokensRank production environment example.
# Copy the API block to /etc/tokensrank/api.env and the Web block to /etc/tokensrank/web.env.
# Set ownership to tokensrank:tokensrank and permissions to 0640:
#   sudo chown tokensrank:tokensrank /etc/tokensrank/api.env /etc/tokensrank/web.env
#   sudo chmod 0640 /etc/tokensrank/api.env /etc/tokensrank/web.env
#
# SECURITY:
# - SUPABASE_SERVICE_ROLE_KEY belongs only in /etc/tokensrank/api.env.
# - ADMIN_PURGE_TOKEN belongs only in /etc/tokensrank/api.env.
# - Never place service-role, admin, or internal fraud config values in /etc/tokensrank/web.env.
# - Values below are examples only. Replace them with Tokens Rank Prod values before deployment.

################################################################################
# API env: /etc/tokensrank/api.env
################################################################################

NODE_ENV=production
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=https://tokensrank.ai,https://www.tokensrank.ai

SUPABASE_URL=https://example-prod-project.supabase.co
SUPABASE_ANON_KEY=example-prod-anon-key
SUPABASE_SERVICE_ROLE_KEY=example-prod-service-role-key

ADMIN_PURGE_TOKEN=example-admin-purge-token-generate-with-openssl-rand-hex-32
CACHE_TTL_SECONDS=3600

FRAUD_FUTURE_THRESHOLD_SEC=300
FRAUD_MAX_BACKDATE_DAYS=14
FRAUD_MAX_SESSION_LIFETIME_DAYS=365
FRAUD_MAX_TOTAL_TOKENS=50000000
FRAUD_MAX_TURNS=10000
FRAUD_BEHAVIOR_ZSCORE_THRESHOLD=4

NEXT_PUBLIC_API_BASE=https://api.tokensrank.ai

# Local app publish exchange target. Packaged/local builds can override this.
TOKENSRANK_HOSTED_API_BASE=https://api.tokensrank.ai
GITHUB_DEVICE_CLIENT_ID=example-github-app-client-id

################################################################################
# Web env: /etc/tokensrank/web.env
################################################################################

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1

NEXT_PUBLIC_API_BASE=https://api.tokensrank.ai
NEXT_PUBLIC_SITE_URL=https://tokensrank.ai
NEXT_PUBLIC_SUPABASE_URL=https://example-prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-prod-anon-key
