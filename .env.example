# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000

# API Server
PORT=3001
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Admin Token
ADMIN_PURGE_TOKEN=your-admin-token-here
COOKIE_SECRET=your-cookie-secret-here

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Address of the user's local dashboard, separate from the hosted public site.
NEXT_PUBLIC_LOCAL_APP_URL=http://localhost:3000

# Local-first app
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=3001
TOKENSRANK_DATA_DIR=
GITHUB_DEVICE_CLIENT_ID=your-github-app-or-oauth-client-id
GITHUB_DEV_TOKEN=
TOKENSRANK_LOCAL_ALLOW_TOKEN_AUTH=false
TOKENSRANK_HOSTED_API_BASE=https://api.tokensrank.ai
TOKENSRANK_HOSTED_SITE_URL=https://tokensrank.ai
